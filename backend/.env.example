# --- Base de datos (Neon) ---
# Conexión con pooler (host con "-pooler"): la usa la app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30&pool_timeout=30&connection_limit=5"
# Conexión directa (sin "-pooler"): la usa Prisma Migrate
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Servidor ---
PORT=4000
NODE_ENV=development
# Orígenes permitidos, separados por coma
CORS_ORIGINS="http://localhost:3000,https://jc-transporte.vercel.app"

# --- Auth ---
# Generá uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambiame-por-un-string-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# --- Reglas de negocio ---
SEAT_HOLD_MINUTES=10
# Horas que tiene el cliente para pagar antes de que la reserva pendiente se cancele sola
PENDING_BOOKING_HOURS=24

# --- Seed (solo para crear los usuarios iniciales) ---
SEED_ADMIN_EMAIL="admin@jctransporte.com.py"
SEED_ADMIN_PASSWORD="cambiame123"
SEED_DRIVER_EMAIL="chofer@jctransporte.com.py"
SEED_DRIVER_PASSWORD="cambiame123"
